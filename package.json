{
  "name": "atiende",
  "version": "0.1.0",
  "description": "Agente conversacional de IA para WhatsApp Business — atiende clientes, RAG sobre catálogo, multi-tenant. Construido sobre Claude API.",
  "private": true,
  "license": "MIT",
  "author": "Christian Henao",
  "repository": {
    "type": "git",
    "url": "https://github.com/Artag-Chris/atiende.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint:check && npm run format:check && npm run test",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "postinstall": "prisma generate || echo 'Prisma generate skipped (DATABASE_URL not set yet — run manually after .env is configured)'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.4.0",
    "openai": "^4.70.0",
    "opossum": "^8.0.0",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/opossum": "^8.1.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}

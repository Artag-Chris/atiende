# ============================================================================
# Atiende - Environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://atiende:atiende_dev@localhost:5432/atiende?schema=public

# ----------------------------------------------------------------------------
# Redis (queue + cache + rate limiting)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Anthropic (primary LLM provider)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-7

# ----------------------------------------------------------------------------
# OpenAI (embeddings + fallback LLM)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------------
# Meta WhatsApp Business API
# ----------------------------------------------------------------------------
# Estas credenciales son GLOBALES a la app de Atiende (no por business).
# Los phone_number_id y access_token por business van encriptados en la tabla
# businesses, no aquí.
#
# Cómo obtenerlas: developers.facebook.com/apps → tu app → WhatsApp / Settings.
# Ver docs/SETUP_META.md (TODO en siguiente iteración) para clickflow.

# App ID público de tu Meta App
META_APP_ID=replace-with-meta-app-id

# App Secret de tu Meta App. CRÍTICO: con esto se verifica que los webhooks
# entrantes realmente vienen de Meta (firma HMAC SHA256). NO público.
META_APP_SECRET=replace-with-meta-app-secret

# String arbitrario que tú inventas. Meta lo manda al hacer GET al webhook
# durante la verificación inicial. Cualquier valor sirve siempre que coincida
# entre lo que pongas en Meta y aquí. Recomendado: 32+ chars aleatorios.
META_WEBHOOK_VERIFY_TOKEN=replace-with-your-verify-token

# Versión de la Graph API de Meta. Actualizar trimestralmente.
META_GRAPH_API_VERSION=v21.0

# ---- DEV ONLY ----
# Phone Number ID y Access Token del test number que Meta te da en la consola.
# En producción multi-tenant, estos viven en businesses.whatsapp_phone_id /
# whatsapp_token_encrypted. Aquí solo para dev con un solo número de prueba.
META_DEV_PHONE_NUMBER_ID=
META_DEV_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# Encryption (for business secrets stored in DB)
# ----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=replace-with-32-bytes-base64

# ----------------------------------------------------------------------------
# Feature flags - LLM
# ----------------------------------------------------------------------------
FEATURE_LLM_PRIMARY=claude
FEATURE_LLM_FALLBACK=
FEATURE_AI_PROMPT_CACHING=true
FEATURE_AI_COMPACTION=true
FEATURE_AI_ADAPTIVE_THINKING=true

# ----------------------------------------------------------------------------
# Feature flags - Channels
# ----------------------------------------------------------------------------
FEATURE_CHANNEL_WHATSAPP=true
FEATURE_CHANNEL_WEB_CHAT=false
FEATURE_CHANNEL_TELEGRAM=false

# ----------------------------------------------------------------------------
# Feature flags - Tools
# ----------------------------------------------------------------------------
FEATURE_TOOL_CATALOG=true
FEATURE_TOOL_ORDERS=true
FEATURE_TOOL_INFO=true
FEATURE_TOOL_ESCALATION=true

# ----------------------------------------------------------------------------
# Feature flags - Caching
# ----------------------------------------------------------------------------
FEATURE_CACHE_EXACT=true
FEATURE_CACHE_SEMANTIC=true
SEMANTIC_CACHE_MIN_SIMILARITY=0.95
SEMANTIC_CACHE_TTL_SECONDS=1800

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
FEATURE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=atiende

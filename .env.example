# ============================================================================
# Atiende - Environment variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# Organized by domain. The Zod schema en src/config/env.ts es la fuente de
# verdad: cualquier var nueva DEBE agregarse ahí también o no arranca.
# ============================================================================

# ============================================================================
# 1. APPLICATION
# ============================================================================
NODE_ENV=development
PORT=3000
# Log level (pino-style): trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Formato de logs: json (prod) | pretty (dev). En CI/prod usar json siempre.
LOG_FORMAT=pretty
# Si vas detrás de un proxy/balanceador (Nginx, Cloudflare, Railway), 1 hop.
TRUST_PROXY=0
# Tiempo máximo para drenar requests al recibir SIGTERM antes de matar el proceso.
SHUTDOWN_TIMEOUT_MS=10000

# ============================================================================
# 2. DATABASE (PostgreSQL 16 + pgvector)
# ============================================================================
DATABASE_URL=postgresql://atiende:atiende_dev@localhost:5432/atiende?schema=public
# Pool de conexiones a Postgres. Default razonable para una instancia pequeña.
# En multi-replica: cada instancia tiene su propio pool, total = N_INSTANCIAS * SIZE.
DB_CONNECTION_POOL_SIZE=10
# Timeout para queries individuales (Prisma). Detecta queries colgadas.
DB_QUERY_TIMEOUT_MS=15000
# Logging de Prisma: 'query,info,warn,error' en dev / 'warn,error' en prod.
PRISMA_LOG_LEVEL=warn,error

# ============================================================================
# 3. REDIS (queue + cache + rate limiting)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# TLS para Redis managed (Upstash, ElastiCache encrypted).
REDIS_TLS=false
# Prefijo para todas las keys de Redis. Crítico si compartes Redis entre
# entornos (dev/staging/prod) para no chocarse.
REDIS_PREFIX=atiende:dev

# ============================================================================
# 4. LLM PROVIDER - Anthropic (primario)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo default. NO downgradear a Sonnet/Haiku sin antes pasar evals.
ANTHROPIC_MODEL=claude-opus-4-7
# Effort (controla profundidad de razonamiento + tokens):
#   low (clasificación simple) | medium | high (default) | xhigh (Opus 4.7 only) | max (Opus only)
ANTHROPIC_EFFORT=high
# Max tokens output por turno. Default amplio porque streaming evita timeouts.
ANTHROPIC_MAX_TOKENS=4096
# Timeout total de una request a la API. Streaming permite valores altos.
ANTHROPIC_TIMEOUT_MS=60000
# Retries en errores 5xx, 429, timeout. Backoff exponencial.
ANTHROPIC_MAX_RETRIES=3
# Habilitar prompt caching nativo (cache_control: ephemeral en system blocks).
ANTHROPIC_PROMPT_CACHING=true
# TTL del cache de Anthropic: 5m (default, write 1.25x) | 1h (write 2x).
# Usa 1h solo para businesses con tráfico continuo donde el ahorro paga el write extra.
ANTHROPIC_CACHE_TTL=5m
# Habilitar adaptive thinking (el modelo decide cuándo pensar).
ANTHROPIC_ADAPTIVE_THINKING=true
# Habilitar compaction (API resume historial cuando se acerca al límite).
ANTHROPIC_COMPACTION=true

# ============================================================================
# 5. LLM PROVIDER - OpenAI (fallback + embeddings)
# ============================================================================
# Requerido para embeddings de RAG. Opcional como fallback LLM (ver §13 arch).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Si configuras OpenAI como fallback LLM, qué modelo usar.
OPENAI_FALLBACK_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=3

# ============================================================================
# 6. META WHATSAPP BUSINESS API
# ============================================================================
# Estas son GLOBALES a la app de Atiende. Per-business credentials van
# encriptadas en businesses.whatsapp_token_encrypted (no aquí).
# Ver docs/SETUP_META.md para el clickflow de creación.

# Tu Meta App ID (público). Settings → Basic → App ID.
META_APP_ID=replace-with-meta-app-id
# Tu Meta App Secret. CRÍTICO: verifica firma HMAC de webhooks entrantes.
META_APP_SECRET=replace-with-meta-app-secret
# String que tú inventas. Meta lo manda en el GET de verificación inicial.
# Recomendado: 32+ chars aleatorios (openssl rand -hex 32).
META_WEBHOOK_VERIFY_TOKEN=replace-with-your-verify-token
# Versión de la Graph API. Revisar trimestralmente — Meta deprecia versiones viejas.
META_GRAPH_API_VERSION=v21.0
# Timeout para llamadas a la Graph API.
META_GRAPH_API_TIMEOUT_MS=15000

# ---- DEV ONLY ----
# Phone Number ID y Access Token del test number gratis de Meta. Solo para
# desarrollo con un solo número. En multi-tenant prod, esto vive en DB.
META_DEV_PHONE_NUMBER_ID=
META_DEV_ACCESS_TOKEN=

# ============================================================================
# 7. ENCRYPTION (secretos por business en DB)
# ============================================================================
# Clave maestra para AES-256-GCM. Cifra tokens de Meta y futuros secretos
# por business en la tabla businesses.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=replace-with-32-bytes-base64

# ============================================================================
# 8. WEBHOOK BEHAVIOR
# ============================================================================
# Ventana para agrupar mensajes consecutivos del mismo cliente antes de
# disparar el agente. Trade-off UX vs eficiencia (FR-5).
WEBHOOK_GROUPING_WINDOW_MS=8000
# Límite de tamaño del body del webhook (KB). Meta manda payloads pequeños;
# valores altos abren la puerta a abuso.
WEBHOOK_BODY_SIZE_LIMIT_KB=128
# Rate limiting de webhooks por business (por minuto) — defensa contra loops.
WEBHOOK_RATE_LIMIT_PER_BUSINESS_PER_MIN=600

# ============================================================================
# 9. AGENT BUDGETS Y LÍMITES
# ============================================================================
# Iteraciones máximas del loop tool_use → tool_result → tool_use. Previene
# loops infinitos si el modelo se queda llamando tools sin converger.
AGENT_MAX_TOOL_ITERATIONS=8
# Tokens máximos de historial antes de forzar compaction agresiva.
AGENT_MAX_CONVERSATION_TOKENS=50000
# Budget de costo por conversación (USD). Si se supera, escalación automática.
# 0 = sin límite. Recomendado 0.50 para producción.
AGENT_BUDGET_USD_PER_CONVERSATION=0.50
# Latencia objetivo p95 por turno (ms). Para alertas, no enforce.
AGENT_TARGET_LATENCY_P95_MS=5000

# ============================================================================
# 10. RAG / RETRIEVAL + KNOWLEDGE INGESTION
# ============================================================================
# Top K productos / chunks a retornar desde search_catalog y search_knowledge.
RAG_TOP_K=5
# Mínimo de similitud coseno para considerar un resultado relevante.
# Por debajo de esto, no aparece en los resultados.
RAG_MIN_SIMILARITY=0.6
# Batch size para indexación masiva (más alto = menos requests a OpenAI
# embeddings, pero más memoria por job).
EMBEDDING_BATCH_SIZE=100

# Chunking para ingesta de PDFs, FAQs, manuales (ver tabla knowledge_chunks).
# 500 tokens es el sweet spot para chunks ricos pero no enormes.
CHUNK_MAX_TOKENS=500
# Overlap evita perder contexto en los bordes de chunks consecutivos.
CHUNK_OVERLAP_TOKENS=50
# Límite de tamaño de archivo subido por el business al dashboard.
KNOWLEDGE_MAX_FILE_SIZE_MB=20

# ============================================================================
# 11. RESPONSE CACHING (capas 2 y 3 - provider-agnostic)
# ============================================================================
# Capa 3: exact cache en Redis (sha256 del query).
FEATURE_CACHE_EXACT=true
EXACT_CACHE_TTL_SECONDS=1800

# Capa 2: semantic cache en pgvector (embeddings + similitud).
FEATURE_CACHE_SEMANTIC=true
# Threshold conservador. Por debajo de 0.95, riesgo de devolver respuestas
# para queries similares-pero-distintas. Solo bajar con evidencia de evals.
SEMANTIC_CACHE_MIN_SIMILARITY=0.95
SEMANTIC_CACHE_TTL_SECONDS=1800
# Limpieza periódica de entradas expiradas (cron en segundos).
SEMANTIC_CACHE_CLEANUP_INTERVAL_S=300

# ============================================================================
# 12. CIRCUIT BREAKER (failover LLM, ver arch §13.3)
# ============================================================================
# Fallos consecutivos antes de abrir el circuit.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# % de errores en ventana que también dispara apertura.
CIRCUIT_BREAKER_ERROR_RATE_THRESHOLD=50
# Ventana para medir error rate (ms).
CIRCUIT_BREAKER_WINDOW_MS=60000
# Tiempo que el circuit queda abierto antes de probar half-open.
CIRCUIT_BREAKER_OPEN_TIMEOUT_MS=30000
# Cantidad de requests de prueba en half-open antes de cerrar.
CIRCUIT_BREAKER_HALF_OPEN_PROBES=1

# ============================================================================
# 13. BULLMQ - colas y workers
# ============================================================================
# Prefijo de colas en Redis. Hereda de REDIS_PREFIX por convención.
# Permite que dev/staging/prod compartan Redis sin chocarse.
BULLMQ_QUEUE_PREFIX=atiende:dev:queue

# Workers — concurrencia por proceso. Escalar horizontal corriendo más
# procesos worker, no subir esto demasiado (un agent_run tarda 2-5s y usa CPU/IO).
BULLMQ_INBOUND_CONCURRENCY=10
BULLMQ_AGENT_CONCURRENCY=4
BULLMQ_OUTBOUND_CONCURRENCY=20
BULLMQ_INDEXING_CONCURRENCY=2
BULLMQ_KNOWLEDGE_INDEXING_CONCURRENCY=2

# Retries y backoff. Backoff exponencial: delay = initialDelayMs * 2^attempt.
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_INITIAL_MS=1000

# Retención de jobs (cuántos guardar para debug). Más alto = más uso de Redis.
BULLMQ_KEEP_COMPLETED=1000
BULLMQ_KEEP_FAILED=5000

# Stalled jobs: si un worker muere a mitad de un job, se reintenta tras este timeout.
BULLMQ_STALLED_INTERVAL_MS=30000

# ============================================================================
# 14. FEATURE FLAGS — LLM
# ============================================================================
FEATURE_LLM_PRIMARY=claude
# Fallback opcional: claude | openai | mock | (vacío = solo static fallback).
FEATURE_LLM_FALLBACK=
FEATURE_AI_PROMPT_CACHING=true
FEATURE_AI_COMPACTION=true
FEATURE_AI_ADAPTIVE_THINKING=true

# ============================================================================
# 15. FEATURE FLAGS — CHANNELS
# ============================================================================
FEATURE_CHANNEL_WHATSAPP=true
FEATURE_CHANNEL_WEB_CHAT=false
FEATURE_CHANNEL_TELEGRAM=false

# ============================================================================
# 16. FEATURE FLAGS — TOOLS
# ============================================================================
FEATURE_TOOL_CATALOG=true
FEATURE_TOOL_KNOWLEDGE_SEARCH=true
FEATURE_TOOL_ORDERS=true
FEATURE_TOOL_INFO=true
FEATURE_TOOL_ESCALATION=true

# ============================================================================
# 17. FEATURE FLAGS — EMBEDDINGS
# ============================================================================
FEATURE_EMBEDDINGS_PROVIDER=openai

# ============================================================================
# 18. OBSERVABILIDAD
# ============================================================================
FEATURE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=atiende
# Sentry para tracking de errores (opcional pero recomendado en prod).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# 19. DASHBOARD / FRONTEND (semana 4+)
# ============================================================================
# URL pública del dashboard (para links en emails de escalamiento).
DASHBOARD_URL=http://localhost:3001
# Orígenes permitidos para CORS (coma-separados).
CORS_ALLOWED_ORIGINS=http://localhost:3001
# JWT secret para sesiones del dashboard.
# Generar: openssl rand -base64 32
JWT_SECRET=replace-with-jwt-secret
JWT_EXPIRES_IN=7d

# ============================================================================
# 20. NOTIFICATIONS (alertas a businesses en escalamientos)
# ============================================================================
# Email transactional. Soporte para Resend, Postmark o SMTP genérico.
NOTIFICATIONS_PROVIDER=resend
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=noreply@atiende.app

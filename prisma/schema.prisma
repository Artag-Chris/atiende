// Atiende - Prisma schema
// Ver docs/01_ARCHITECTURE.md §2.4 para el modelo conceptual completo.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================================================
// TENANT
// ============================================================================

/// Un business es un tenant. Cada uno tiene su propio número de WhatsApp,
/// catálogo, configuración y feature overrides.
model Business {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String
  whatsappPhoneId        String    @unique @map("whatsapp_phone_id")
  /// Token de Meta cifrado con la ENCRYPTION_MASTER_KEY (AES-256-GCM).
  whatsappTokenEncrypted String    @map("whatsapp_token_encrypted")
  /// Tono, personalidad, instrucciones extra inyectadas al system prompt.
  systemPromptExtras     String?   @map("system_prompt_extras")
  /// Config arbitraria por business (horarios, ubicación, métodos de pago).
  settings               Json      @default("{}") @map("settings_jsonb")
  /// Feature overrides por business (ver Feature flags en arquitectura §11.4).
  featureOverrides       Json      @default("{}") @map("feature_overrides_jsonb")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  archivedAt             DateTime? @map("archived_at")

  products           Product[]
  conversations      Conversation[]
  orders             Order[]
  inboundMessages    InboundMessage[]
  responseCache      ResponseCache[]
  agentRuns          AgentRun[]
  knowledgeDocuments KnowledgeDocument[]
  businessUsers      BusinessUser[]

  @@index([archivedAt])
  @@map("businesses")
}

// ============================================================================
// DASHBOARD USERS
// ============================================================================

/// Usuarios del dashboard web. Cada uno pertenece a un business.
model BusinessUser {
  id           String            @id @default(uuid()) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  email        String            @unique
  name         String
  password     String
  role         BusinessUserRole  @default(ADMIN)
  tokenVersion Int               @default(0) @map("token_version")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loginAttempts LoginAttempt[]

  @@index([businessId])
  @@map("business_users")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @map("created_at")

  user BusinessUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@map("login_attempts")
}

enum BusinessUserRole {
  ADMIN
  SUPER_ADMIN

  @@map("business_user_role")
}

// ============================================================================
// CATÁLOGO
// ============================================================================

/// Un producto del catálogo de un business. La descripción se usa para generar
/// el embedding que sirve a la búsqueda semántica.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  category    String?
  imageUrl    String?  @map("image_url")
  metadata    Json     @default("{}") @map("metadata_jsonb")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  embedding ProductEmbedding?

  @@index([businessId, active])
  @@index([businessId, category])
  @@map("products")
}

/// Embedding del nombre+descripción de un producto para RAG.
/// Dimensión 1536 corresponde a OpenAI text-embedding-3-small.
/// El índice HNSW se crea en migración SQL (Prisma no lo soporta inline aún).
model ProductEmbedding {
  productId String                      @id @map("product_id") @db.Uuid
  embedding Unsupported("vector(1536)")
  updatedAt DateTime                    @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_embeddings")
}

// ============================================================================
// MENSAJERÍA
// ============================================================================

enum ConversationStatus {
  ACTIVE // agente atentiendo normalmente
  ESCALATED // pasó a humano del business
  RESOLVED // cerrada (orden creada o cliente satisfecho)
  ABANDONED // sin actividad > 24h

  @@map("conversation_status")
}

enum ConversationUrgency {
  LOW
  MEDIUM
  HIGH

  @@map("conversation_urgency")
}

enum Channel {
  WHATSAPP
  WEB_CHAT
  TELEGRAM

  @@map("channel")
}

/// Una conversación entre un cliente final (identificado por su número) y un business.
/// Único por (business_id, customer_identifier, channel) — un cliente puede tener
/// conversaciones separadas en distintos canales con el mismo business.
model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  businessId         String             @map("business_id") @db.Uuid
  /// Canal por el que entra/sale la conversación.
  channel            Channel            @default(WHATSAPP)
  /// Identificador del cliente en ese canal (teléfono en WhatsApp, sessionId en webchat, etc.).
  customerIdentifier String             @map("customer_identifier")
  status             ConversationStatus @default(ACTIVE)
  /// Resumen generado por compaction cuando el historial crece.
  summaryText        String?            @map("summary_text")
  lastMessageAt      DateTime?          @map("last_message_at")
  escalatedAt        DateTime?          @map("escalated_at")
  escalationReason   String?             @map("escalation_reason")
  urgency            ConversationUrgency @default(MEDIUM)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages  Message[]
  agentRuns AgentRun[]
  orders    Order[]

  @@unique([businessId, channel, customerIdentifier])
  @@index([businessId, status, lastMessageAt])
  @@map("conversations")
}

enum MessageRole {
  USER // cliente final (mensaje entrante WhatsApp)
  ASSISTANT // agente Atiende
  TOOL // resultado de una tool ejecutada por el agente
  SYSTEM // marcadores internos (escalamiento, fin de turno, etc.)

  @@map("message_role")
}

/// Cada mensaje individual de una conversación.
/// content_jsonb permite guardar mensajes multimodales (texto, imagen futura, tool_use blocks).
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  /// Contenido estructurado (Anthropic-compatible: array de content blocks).
  content        Json        @map("content_jsonb")
  /// Tokens usados por este mensaje (solo en mensajes de ASSISTANT).
  tokenUsage     Json?       @map("token_usage_jsonb")
  /// Origen del mensaje USER entrante (InboundMessage persistido por el webhook).
  /// Único por mensaje → hace idempotente el USER save ante reintentos del job.
  inboundMessageId String?   @unique @map("inbound_message_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inboundMessage InboundMessage? @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Raw store de mensajes entrantes ANTES de procesarlos.
/// Se persisten en el webhook receiver para garantizar zero loss (NFR-8).
model InboundMessage {
  id                String    @id @default(uuid()) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  /// Payload completo de Meta tal cual llegó (debug + replay).
  rawPayload        Json      @map("raw_payload_jsonb")
  /// Hash del mensaje para idempotencia (mismo mensaje 2 veces = procesado 1 vez).
  externalMessageId String    @map("external_message_id")
  processedAt       DateTime? @map("processed_at")
  receivedAt        DateTime  @default(now()) @map("received_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([businessId, externalMessageId])
  @@index([processedAt])
  @@map("inbound_messages")
}

// ============================================================================
// TELEMETRÍA Y EVALS
// ============================================================================

enum CacheHitLayer {
  EXACT // capa 3 - Redis sha256
  SEMANTIC // capa 2 - pgvector cosine

  @@map("cache_hit_layer")
}

/// Cada ejecución del agente (un turno). Una fila por llamada al LLM.
/// Base de las métricas de costo, latencia y calidad. Ver arquitectura §10.
///
/// businessId está denormalizado (también accesible vía conversation.business_id)
/// para evitar JOINs en queries de dashboard ("costos por business este mes").
model AgentRun {
  id                       String         @id @default(uuid()) @db.Uuid
  businessId               String         @map("business_id") @db.Uuid
  conversationId           String         @map("conversation_id") @db.Uuid
  model                    String // 'claude-opus-4-7', etc.
  llmProvider              String         @map("llm_provider") // 'claude', 'openai', ...
  latencyMs                Int            @map("latency_ms")
  inputTokens              Int            @map("input_tokens")
  outputTokens             Int            @map("output_tokens")
  cacheCreationInputTokens Int            @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int            @default(0) @map("cache_read_input_tokens")
  costUsd                  Decimal        @map("cost_usd") @db.Decimal(10, 6)
  /// Tool calls de este turno: array de { name, input, latencyMs, success }.
  toolCalls                Json           @default("[]") @map("tool_calls_jsonb")
  stopReason               String?        @map("stop_reason")
  /// Si el turno usó cache (response cache), qué capa.
  cacheHitLayer            CacheHitLayer? @map("cache_hit_layer_enum")
  cacheHitSimilarity       Decimal?       @map("cache_hit_similarity") @db.Decimal(5, 4)
  createdAt                DateTime       @default(now()) @map("created_at")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("agent_runs")
}

// ============================================================================
// ÓRDENES
// ============================================================================

enum OrderStatus {
  PENDING // creada por el agente, pendiente de confirmación del business
  CONFIRMED // confirmada por el business
  CANCELLED // cancelada
  FULFILLED // entregada

  @@map("order_status")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  businessId     String      @map("business_id") @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// Info del cliente: { name, phone, address, deliveryNotes }.
  customerInfo   Json        @map("customer_info_jsonb")
  /// Items: [{ productId, name, quantity, unitPrice }].
  /// NOTA tech-debt: en v2 podríamos modelar OrderItem como tabla separada
  /// para analytics ("producto más ordenado"). Ver docs/AUDIT.md.
  items          Json        @map("items_jsonb")
  total          Decimal     @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@index([conversationId])
  @@map("orders")
}

// ============================================================================
// CACHING (capa 2 - semantic response cache)
// ============================================================================

/// Cache de respuestas indexado por embedding del query.
/// Permite reutilizar respuestas cuando un cliente hace una pregunta
/// semánticamente similar a una previa. Ver arquitectura §12.
///
/// CRÍTICO: embeddingModel se guarda para invalidación al cambiar de modelo.
/// Si el embedding model cambia, los vectores viejos quedan en otro espacio
/// y los matches se vuelven basura. El service debe filtrar por embeddingModel.
model ResponseCache {
  id             String                      @id @default(uuid()) @db.Uuid
  businessId     String                      @map("business_id") @db.Uuid
  /// Modelo usado para generar este embedding. Ej: 'text-embedding-3-small'.
  embeddingModel String                      @map("embedding_model")
  /// Query del cliente. Considerar: si puede contener PII, hashear antes.
  /// Por ahora plaintext porque queries cacheables son no-personales (FAQ, etc.)
  /// y la safety rail `hasPersonalInfo` ya bypasea el cache cuando hay PII.
  queryText      String                      @map("query_text")
  queryEmbedding Unsupported("vector(1536)") @map("query_embedding")
  responseText   String                      @map("response_text")
  /// Si la respuesta involucró tools, guardamos cuáles (para invalidación selectiva).
  toolCalls      Json                        @default("[]") @map("tool_calls_jsonb")
  hitCount       Int                         @default(0) @map("hit_count")
  lastUsedAt     DateTime?                   @map("last_used_at")
  expiresAt      DateTime                    @map("expires_at")
  createdAt      DateTime                    @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, embeddingModel, expiresAt])
  @@index([expiresAt]) // para job de cleanup
  @@map("response_cache")
}

// ============================================================================
// KNOWLEDGE INGESTION (FAQ, políticas, PDFs, manuales)
// ============================================================================
//
// Complementa el catálogo (Product) con conocimiento no-estructurado del business.
// El agente lo consulta vía la tool `search_knowledge`. Ver arch §14.

enum KnowledgeKind {
  FAQ // Preguntas frecuentes (horarios, ubicación, métodos de pago)
  POLICY // Políticas (devolución, garantía, envío)
  PDF_CATALOG // Catálogo en PDF (complementa products estructurados)
  MANUAL // Manuales de uso de productos
  NOTES // Notas libres del business
  OTHER

  @@map("knowledge_kind")
}

enum KnowledgeStatus {
  PENDING // Subido, sin procesar
  EXTRACTING // Extrayendo texto del archivo
  CHUNKING // Dividiendo en chunks
  EMBEDDING // Generando embeddings
  INDEXED // Listo para uso
  FAILED // Falló en algún paso (ver errorMessage)

  @@map("knowledge_status")
}

/// Un documento de conocimiento subido por el business (PDF, FAQ, política, etc.).
/// Es la unidad lógica que el business ve en el dashboard.
model KnowledgeDocument {
  id           String          @id @default(uuid()) @db.Uuid
  businessId   String          @map("business_id") @db.Uuid
  kind         KnowledgeKind
  title        String
  /// Identificador del origen: filename del PDF, "form:faq:horarios", URL de
  /// donde se importó, etc. Único por business — re-subir mismo source actualiza.
  source       String
  /// SHA256 del contenido original. Si re-subes y no cambia, no se re-indexa.
  sourceHash   String          @map("source_hash")
  /// Estado del pipeline de ingesta.
  status       KnowledgeStatus @default(PENDING)
  /// Mensaje de error si status=FAILED.
  errorMessage String?         @map("error_message")
  /// Cuántos chunks se generaron al indexar (para mostrar al business).
  chunkCount   Int             @default(0) @map("chunk_count")
  /// Si false, los chunks no se consideran en la búsqueda (soft-delete).
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  /// Timestamp del último indexado exitoso.
  indexedAt    DateTime?       @map("indexed_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks   KnowledgeChunk[]

  @@unique([businessId, source])
  @@index([businessId, kind, active])
  @@index([businessId, status])
  @@map("knowledge_documents")
}

/// Un chunk individual de un documento, con su embedding.
/// Es la unidad de retrieval para la tool search_knowledge.
///
/// businessId y kind están DENORMALIZADOS desde el documento padre para
/// permitir queries multi-tenant + filtro por tipo sin JOIN (crítico para
/// latencia de retrieval).
model KnowledgeChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  documentId     String                      @map("document_id") @db.Uuid
  businessId     String                      @map("business_id") @db.Uuid
  kind           KnowledgeKind
  /// Posición ordinal del chunk dentro del documento (0-indexed).
  position       Int
  text           String
  /// Localizador para citas: "ver pág. 12", "fila 5", "sección Devoluciones".
  pageNumber     Int?                        @map("page_number")
  /// Modelo usado para generar el embedding. Crítico para invalidación al cambiar de modelo.
  embeddingModel String                      @map("embedding_model")
  embedding      Unsupported("vector(1536)")
  createdAt      DateTime                    @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([businessId, kind, embeddingModel])
  @@index([documentId, position])
  @@map("knowledge_chunks")
}

// ============================================================================
// EVALS
// ============================================================================

/// Un caso de eval. Setup de la conversación + outcome esperado.
/// Ver docs/02_AI_CONCEPTS.md §13 para la metodología.
model EvalCase {
  id                String   @id @default(uuid()) @db.Uuid
  /// 'greeting' | 'product_query' | 'complaint' | 'order' | 'edge' | etc.
  category          String
  /// Setup: { businessSeed, conversationHistory, incomingMessage }.
  conversationSetup Json     @map("conversation_setup_jsonb")
  /// Esperado: { intent, shouldEscalate, shouldCreateOrder, expectedTools, ... }.
  expectedOutcome   Json     @map("expected_outcome_jsonb")
  tags              String[]
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  runs EvalRun[]

  @@index([category])
  @@map("eval_cases")
}

/// Resultado de correr un eval case con una versión específica del agente.
model EvalRun {
  id           String   @id @default(uuid()) @db.Uuid
  evalCaseId   String   @map("eval_case_id") @db.Uuid
  /// Hash del commit o tag de la versión del agente evaluada.
  agentVersion String   @map("agent_version")
  passed       Boolean
  output       Json     @map("output_jsonb")
  /// Notas o diff vs expected.
  notes        String?
  durationMs   Int      @map("duration_ms")
  costUsd      Decimal  @map("cost_usd") @db.Decimal(10, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  evalCase EvalCase @relation(fields: [evalCaseId], references: [id], onDelete: Cascade)

  @@index([evalCaseId, agentVersion])
  @@index([agentVersion, createdAt])
  @@map("eval_runs")
}
